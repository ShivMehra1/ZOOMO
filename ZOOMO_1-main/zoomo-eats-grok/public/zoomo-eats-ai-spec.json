{
  "product": {
    "name": "Zoomo Eats",
    "variant": "Customer",
    "tagline": "Fastest food delivery with real-time tracking & great offers.",
    "liveUrl": "https://zoomo-self.vercel.app",
    "backend": "https://zoomo-production.up.railway.app",
    "stackObserved": "React + Vite SPA, React Router, Poppins, Tailwind, inline theme objects",
    "audience": "End customers ordering food. Merchant users are rejected at login.",
    "currency": "INR (₹) even when some catalog prices look USD-like",
    "coverage": "45+ cities"
  },
  "brand": {
    "font": "Poppins 300/400/500/600/700",
    "logoMark": "Stylized Z: three lime strokes (M6 10H22, M22 10L10 22, M10 22H26) on #0F3D2E rounded square. Header uses an image logo 36px tall.",
    "tokens": {
      "page": "#F5F7F6",
      "surface": "#FFFFFF",
      "primary": "#0F3D2E",
      "hover": "#145A43",
      "accent": "#22C55E",
      "textMain": "#0B0F0E",
      "textSub": "#6B7280",
      "textMuted": "#9CA3AF",
      "border": "#E5E7EB",
      "borderSoft": "#F0F2F1",
      "error": "#DC2626",
      "pink": "#EC4899",
      "veg": "#16A34A",
      "nonveg": "#DC2626"
    },
    "gradients": {
      "primaryCta": "linear-gradient(135deg, #0F3D2E 0%, #145A43 100%)",
      "heroOverlay": "linear-gradient(135deg, rgba(15,61,46,0.82) 0%, rgba(20,90,67,0.72) 100%)",
      "menuHero": "linear-gradient(to top, rgba(11,15,14,0.85) 0%, rgba(11,15,14,0.2) 60%, rgba(11,15,14,0.35) 100%)"
    },
    "radii": {
      "chip": 999,
      "button": 10,
      "card": 20,
      "sheet": 28,
      "input": 12
    },
    "shadows": {
      "headerScrolled": "0 2px 20px rgba(15,61,46,0.07)",
      "cta": "0 2px 8px rgba(15,61,46,0.25)",
      "cardHover": "0 12px 40px rgba(15,61,46,0.13)",
      "authCard": "0 10px 48px rgba(15,61,46,0.10)",
      "search": "0 8px 32px rgba(0,0,0,0.25)"
    },
    "motion": "120–180ms ease-out hover; card lifts -3px; image scales 1.05; reduced chrome blur 16px"
  },
  "routes": [
    {
      "path": "/",
      "auth": false,
      "screen": "Home / landing with location gate"
    },
    {
      "path": "/login",
      "auth": false,
      "screen": "Login card"
    },
    {
      "path": "/signup",
      "auth": false,
      "screen": "Two-step signup"
    },
    {
      "path": "/restaurants",
      "auth": false,
      "screen": "Full restaurant directory"
    },
    {
      "path": "/restaurant/:id",
      "auth": false,
      "screen": "Restaurant menu"
    },
    {
      "path": "/cart",
      "auth": false,
      "screen": "Cart (empty if logged out)"
    },
    {
      "path": "/checkout",
      "auth": true,
      "screen": "Checkout: delivery / dine-in / takeaway"
    },
    {
      "path": "/orders",
      "auth": true,
      "screen": "My Orders list"
    },
    {
      "path": "/orders/:id",
      "auth": true,
      "screen": "Order detail + status"
    }
  ],
  "api": {
    "base": "https://zoomo-production.up.railway.app",
    "authHeader": "Authorization: Bearer <access_token>",
    "tokenKey": "localStorage.access_token",
    "endpoints": [
      "GET /users/me",
      "POST /auth/login  → { access_token|accesstoken, user }  user.role MUST be USER (else 'Please login from Merchant app!')",
      "POST /auth/signup",
      "GET /restaurants",
      "GET /restaurants/:id",
      "GET /dishes?restaurantId=",
      "GET /dishes/:id",
      "GET /cart   POST /cart/items {dishId, quantity}  DELETE /cart/items/:id",
      "GET /addresses  POST /addresses",
      "POST /orders  GET /orders/mine  GET /orders/:id"
    ]
  },
